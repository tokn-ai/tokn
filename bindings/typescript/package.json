{
  "name": "@tokn/sdk",
  "version": "0.2.3",
  "description": "In-process TypeScript SDK for tokn routing and provider integrations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "_native.cjs"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:ts",
    "build:native": "cross-env MACOSX_DEPLOYMENT_TARGET=11.0 napi build --platform --output-dir . --js _native.cjs --dts _native.d.ts -- --locked",
    "build:native:release": "cross-env MACOSX_DEPLOYMENT_TARGET=11.0 napi build --platform --release --output-dir . --js _native.cjs --dts _native.d.ts -- --locked",
    "build:ts": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:node && pnpm test:bun",
    "test:node": "pnpm test:unit:node && pnpm test:native:node",
    "test:bun": "pnpm test:unit:bun && pnpm test:native:bun",
    "test:unit:node": "node --import tsx --test tests/client.test.ts tests/request.test.ts",
    "test:unit:bun": "bun test tests/client.test.ts tests/request.test.ts",
    "test:native": "pnpm test:native:node && pnpm test:native:bun",
    "test:native:node": "cross-env TOKN_NATIVE_SMOKE=1 node --import tsx --test tests/native.test.ts tests/dist.test.mjs",
    "test:native:bun": "cross-env TOKN_NATIVE_SMOKE=1 bun test tests/native.test.ts tests/dist.test.mjs",
    "release:pack": "node --experimental-strip-types scripts/release.ts pack",
    "release:test": "node --experimental-strip-types scripts/release.ts test",
    "release:check-glibc": "node --experimental-strip-types scripts/release.ts check-glibc"
  },
  "napi": {
    "binaryName": "tokn_sdk",
    "packageName": "@tokn/sdk",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tokn-ai/tokn.git",
    "directory": "bindings/typescript"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@tokn/sdk-darwin-arm64": "0.2.3",
    "@tokn/sdk-linux-x64-gnu": "0.2.3",
    "@tokn/sdk-win32-x64-msvc": "0.2.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.1",
    "@types/node": "22.20.1",
    "cross-env": "10.1.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
